# SafeSphere Backend Environment
# Local development default:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model paths
# Use paths relative to backend/ when running uvicorn from backend folder,
# or absolute paths on the server in production.
TOXICITY_MODEL_PATH=../models/toxicity/toxic_model.pth
VIOLENCE_MODEL_PATH=../models/violence/violence.weights.h5
TOXICITY_TOKENIZER_DIR=../models/toxicity/tokenizer
TOXICITY_BASE_MODEL_DIR=../models/toxicity/base_model

# Runtime settings
ENABLE_SHAP=false
IMAGE_SIZE=224
TEXT_MAX_LENGTH=128

# Decision thresholds
TOXIC_THRESHOLD=0.70
VIOLENCE_THRESHOLD=0.70
REVIEW_THRESHOLD=0.50
