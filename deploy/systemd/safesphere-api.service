[Unit]
Description=SafeSphere FastAPI backend
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/safesphere/backend
EnvironmentFile=/var/www/safesphere/backend/.env
ExecStart=/var/www/safesphere/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
